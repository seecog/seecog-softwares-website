        <script>
            (function () {
                var root = document.querySelector("[data-product-carousel]");
                if (!root) return;
                var slides = Array.prototype.slice.call(root.querySelectorAll("[data-product-slide]"));
                var tabs = Array.prototype.slice.call(root.querySelectorAll("[data-product-tab]"));
                var count = root.querySelector("[data-product-count]");
                var index = 0;
                var timer = null;
                var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                function show(next) {
                    index = (next + slides.length) % slides.length;
                    slides.forEach(function (slide, i) {
                        var active = i === index;
                        slide.classList.toggle("is-active", active);
                        slide.hidden = !active;
                    });
                    tabs.forEach(function (tab, i) {
                        var active = i === index;
                        tab.classList.toggle("is-active", active);
                        tab.setAttribute("aria-selected", active ? "true" : "false");
                        if (active && tab.parentElement) {
                            var list = tab.parentElement;
                            var target = tab.offsetLeft - 12;
                            if (target < list.scrollLeft || target + tab.offsetWidth > list.scrollLeft + list.clientWidth) {
                                list.scrollLeft = Math.max(0, target);
                            }
                        }
                    });
                    if (count) {
                        count.textContent = String(index + 1).padStart(2, "0") + " / " + String(slides.length).padStart(2, "0");
                    }
                }

                function stop() {
                    if (timer) {
                        window.clearInterval(timer);
                        timer = null;
                    }
                }

                function start() {
                    if (reduceMotion || timer) return;
                    timer = window.setInterval(function () { show(index + 1); }, 5500);
                }

                root.querySelector("[data-product-prev]").addEventListener("click", function () { show(index - 1); });
                root.querySelector("[data-product-next]").addEventListener("click", function () { show(index + 1); });
                tabs.forEach(function (tab, i) {
                    tab.addEventListener("click", function () { show(i); });
                });
                root.addEventListener("keydown", function (event) {
                    if (event.key === "ArrowRight") {
                        show(index + 1);
                        event.preventDefault();
                    } else if (event.key === "ArrowLeft") {
                        show(index - 1);
                        event.preventDefault();
                    }
                });
                root.addEventListener("mouseenter", stop);
                root.addEventListener("mouseleave", start);
                root.addEventListener("focusin", stop);
                root.addEventListener("focusout", function (event) {
                    if (!root.contains(event.relatedTarget)) start();
                });

                var touchX = null;
                root.addEventListener("touchstart", function (event) {
                    touchX = event.changedTouches[0].clientX;
                }, { passive: true });
                root.addEventListener("touchend", function (event) {
                    if (touchX == null) return;
                    var delta = event.changedTouches[0].clientX - touchX;
                    if (Math.abs(delta) > 40) show(delta < 0 ? index + 1 : index - 1);
                    touchX = null;
                }, { passive: true });

                show(0);
                start();
            })();
        </script>
