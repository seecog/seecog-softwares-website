                if (!root) return;
                var slides = Array.prototype.slice.call(root.querySelectorAll("[data-product-slide]"));
                var tabs = Array.prototype.slice.call(root.querySelectorAll("[data-product-tab]"));
                var count = root.querySelector("[data-product-count]");
                var index = 0;
                var timer = null;
                var imageTimer = null;
                var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                root.querySelectorAll("[data-image-slider]").forEach(function (slider) {
                    var track = slider.querySelector("[data-image-track]");
                    var frames = Array.prototype.slice.call(slider.querySelectorAll("[data-image-slide]"));
                    var dots = Array.prototype.slice.call(slider.querySelectorAll("[data-image-dot]"));
                    var caption = slider.querySelector("[data-image-caption]");
                    var imageIndex = 0;

                    function showImage(next) {
                        if (!frames.length) return;
                        imageIndex = (next + frames.length) % frames.length;
                        if (track) {
                            var viewport = slider.querySelector(".product-image-slider-viewport");
                            var width = viewport ? viewport.clientWidth : track.clientWidth;
                            track.style.transform = "translate3d(" + (-imageIndex * width) + "px, 0, 0)";
                        }
                        frames.forEach(function (frame, i) {
                            frame.classList.toggle("is-active", i === imageIndex);
                        });
                        dots.forEach(function (dot, i) {
                            var active = i === imageIndex;
                            dot.classList.toggle("is-active", active);
                            dot.setAttribute("aria-selected", active ? "true" : "false");
                        });
                        if (caption) caption.textContent = frames[imageIndex].getAttribute("data-label") || "";
                    }

                    dots.forEach(function (dot, i) {
                        dot.addEventListener("click", function (event) {
                            event.stopPropagation();
                            showImage(i);
                        });
                    });

                    slider._resetImage = function () { showImage(0); };
                    slider._nextImage = function () { showImage(imageIndex + 1); };
                    slider._prevImage = function () { showImage(imageIndex - 1); };
                    slider._imageCount = frames.length;
                    showImage(0);
                });

                function stopImageSlider() {
                    if (imageTimer) {
                        window.clearInterval(imageTimer);
                        imageTimer = null;
                    }
                }

                function startImageSlider(slide) {
                    stopImageSlider();
                    if (reduceMotion || !slide) return;
                    var slider = slide.querySelector("[data-image-slider]");
                    if (!slider || !slider._nextImage || slider._imageCount < 2) return;
                    slider._resetImage();
                    imageTimer = window.setInterval(function () { slider._nextImage(); }, 2200);
                }

                function show(next) {
                    index = (next + slides.length) % slides.length;
                    slides.forEach(function (slide, i) {
                        var active = i === index;
                        slide.classList.toggle("is-active", active);
                        slide.hidden = !active;
                    });
                    tabs.forEach(function (tab, i) {
                        var active = i === index;
                        tab.classList.toggle("is-active", active);
                        tab.setAttribute("aria-selected", active ? "true" : "false");
                        if (active && tab.parentElement) {
                            var list = tab.parentElement;
                            var target = tab.offsetLeft - 12;
                            if (target < list.scrollLeft || target + tab.offsetWidth > list.scrollLeft + list.clientWidth) {
                                list.scrollLeft = Math.max(0, target);
                            }
                        }
                    });
                    if (count) {
                        count.textContent = String(index + 1).padStart(2, "0") + " / " + String(slides.length).padStart(2, "0");
                    }
                    startImageSlider(slides[index]);
                }

                function waitFor(slide) {
                    var slider = slide && slide.querySelector("[data-image-slider]");
                    if (slider) {
                        var total = slider.querySelectorAll("[data-image-slide]").length || 1;
                        return total * 2400;
                    }
                    return 5500;
                }

                function stop() {
                    if (timer) {
                        window.clearTimeout(timer);
                        timer = null;
                    }
                }

                function start() {
                    if (reduceMotion || timer) return;
                    timer = window.setTimeout(function () {
                        timer = null;
                        show(index + 1);
                        start();
                    }, waitFor(slides[index]));
                }

                function go(next) {
                    show(next);
                    stop();
                    start();
                }

                root.querySelector("[data-product-prev]").addEventListener("click", function () { go(index - 1); });
                root.querySelector("[data-product-next]").addEventListener("click", function () { go(index + 1); });
                tabs.forEach(function (tab, i) {
                    tab.addEventListener("click", function () { go(i); });
                });
                root.addEventListener("keydown", function (event) {
                    if (event.key === "ArrowRight") {
                        go(index + 1);
                        event.preventDefault();
                    } else if (event.key === "ArrowLeft") {
                        go(index - 1);
                        event.preventDefault();
                    }
                });
                root.addEventListener("mouseenter", stop);
                root.addEventListener("mouseleave", start);
                root.addEventListener("focusin", stop);
                root.addEventListener("focusout", function (event) {
                    if (!root.contains(event.relatedTarget)) start();
                });

                var touchX = null;
                var touchSlider = null;
                root.addEventListener("touchstart", function (event) {
                    touchX = event.changedTouches[0].clientX;
                    var slider = slides[index] && slides[index].querySelector("[data-image-slider]");
                    touchSlider = slider && slider.contains(event.target) ? slider : null;
                }, { passive: true });
                root.addEventListener("touchend", function (event) {
                    if (touchX == null) return;
                    var delta = event.changedTouches[0].clientX - touchX;
                    if (Math.abs(delta) > 40) {
                        if (touchSlider && touchSlider._nextImage) {
                            if (delta < 0) touchSlider._nextImage();
                            else touchSlider._prevImage();
                        } else {
                            go(delta < 0 ? index + 1 : index - 1);
                        }
                    }
                    touchX = null;
                    touchSlider = null;
                }, { passive: true });

                show(0);
                start();
            })();
        </script>
    </body>
</html>