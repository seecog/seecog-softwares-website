# Admin seed user
ADMIN_EMAIL=admin@seecogsoftwares.com
ADMIN_PASSWORD=Admin@123

# Email - SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
